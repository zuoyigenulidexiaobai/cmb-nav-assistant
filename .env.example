# ---------------------------------------------------------------------------
# 复制本文件为 .env 后填写。.env 已被 .gitignore 排除，不要提交到仓库。
# 真实环境变量优先级高于本文件（外部注入的值不会被覆盖）。
# ---------------------------------------------------------------------------

# ---- 数据源参数（必填，缺一不可）------------------------------------------
# 注意：目前仅支持招商银行理财产品净值接口；其他银行/基金需替换 server/cmb.js 适配层。
# 净值接口基地址（招商银行）
CMB_NAV_API_BASE=
# 接口 appId
CMB_NAV_APP_ID=
# 接口签名密钥
CMB_NAV_AUTH_KEY=
# 接口业务标识
CMB_NAV_BUSINESS_ID=

# ---- 服务端（可选）--------------------------------------------------------
# HTTP 监听端口，默认 9001
#PORT=9001
# 监听地址，默认 0.0.0.0
#HOST=127.0.0.1
# 置 1 时信任代理写入的 X-Real-IP 等请求头；本地直连请保持关闭
#TRUST_PROXY=1
# 运行时数据目录（SQLite 库 + auth.json），默认 <项目根>/data
#DATA_DIR=./data
# 前端构建产物目录，默认 <项目根>/dist
#DIST_DIR=./dist

# ---- 登录与定时（可选）----------------------------------------------------
# 首次启动的初始登录口令；不填则随机生成并打印到日志
#CMB_NAV_PASSWORD=
# 定时抓取时刻（Asia/Shanghai，24 小时制），默认 09:00
#CMB_NAV_SCHEDULE_HOUR=9
#CMB_NAV_SCHEDULE_MINUTE=0
# 定时/补抓失败后的自动重试延迟（毫秒，逗号分隔），默认 5 分钟、10 分钟
#CMB_NAV_RETRY_DELAY_MS=300000,600000
